erDiagram
    user {
        number user_id PK
        string username UK
        string avatar_url
        string status
        string platform_role
    }

    community {
        number community_id PK
        string title UK
        string description
        string slug UK
        string avatar_url
        string status
        number owner_id FK
    }

    membership {
        number membership_id PK
        number community_id PK,FK
        number user_id PK,FK
        string community_role
    }

    message {
        number message_id PK
        number author_id FK
        string text_content
        number recipient_id FK "nullable, for personal message"
        number community_id FK "nullable, for community message"
        number replies_to_id FK "nullable"
    }

    user ||--o{ community : "owns"
    user ||--o{ membership : "joins"
    user ||--o{ message : "sends"
    user ||--o{ message : "receives personal"
    community ||--o{ membership : "has"
    community ||--o{ message : "contains"
    message ||--o{ message : "replies to"
